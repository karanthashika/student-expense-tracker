# Supabase connection for the Student Expense Tracker.
# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). The anon key is safe to expose in the browser;
# never put the service role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
